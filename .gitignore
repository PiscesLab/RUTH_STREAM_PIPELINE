# Virtual environments
venv/
statefun-venv/
*.egg-info/
__pycache__/
*.py[cod]

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python
.Python
*.so
.env
.env.local

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Logs
*.log
logs/

# Simulation input. The floating car data is produced by RUTH, is 21 GB across
# the runs used here, and is not distributed with the code; paths are given on
# the command line.
inputfiles/
*.h5

# Rebuilt from the FCD by ml/segment_minutes.py
ml/cache/

# Trained artefacts are committed: retraining needs the full RUTH output, so
# without them a clone cannot run. ml/models/model_card.json records the
# configuration they were trained with.
ml/models/*.joblib

# Generated by cluster/up.sh from flink-conf.checkpoints-{on,off}.yaml
cluster/.flink-conf.in-use.yaml

# The manuscript is kept out of this repository; it lives in Overleaf.
paper/
